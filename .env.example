# Telegram - tạo bot qua @BotFather để lấy token,
# sau đó nhắn cho bot 1 tin rồi chạy "node src/cli.js chatid" để lấy chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trình duyệt dùng để mở trang: msedge (mặc định, có sẵn trên Windows) hoặc chrome
BROWSER_CHANNEL=msedge

# Chu kỳ kiểm tra ở chế độ watch (phút)
CHECK_INTERVAL_MINUTES=30

# Dự phòng: đặt false nếu chạy ẩn bị TikTok chặn (sẽ mở Edge với cửa sổ nằm ngoài màn hình)
BROWSER_HEADLESS=true
